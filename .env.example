# ─────────────────────────────────────────────────────────────
# Portfolio Email Service Configuration
# Set these in your Netlify Dashboard (Site configuration → Environment variables)
# ─────────────────────────────────────────────────────────────

# Option 1: Brevo (Recommended — 300 free emails/day)
# 1. Sign up at https://app.brevo.com
# 2. Go to SMTP & API -> Generate a new API Key
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
SENDER_EMAIL=singhkunal1642@gmail.com

# Option 2: Nodemailer with Gmail (Alternative)
# 1. Go to Google Account -> Security -> 2-Step Verification -> App Passwords
# 2. Generate a 16-character App Password
EMAIL_USER=singhkunal1642@gmail.com
EMAIL_PASS=your_16_character_google_app_password

# Target inbox for contact form submissions
TO_EMAIL=singhkunal1642@gmail.com

# Option 3: Formspree (Optional fallback)
# VITE_FORMSPREE_ID=your_formspree_id
